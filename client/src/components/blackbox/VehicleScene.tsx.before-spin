import { Canvas } from "@react-three/fiber";
import {
  AdaptiveDpr,
  Html,
  Line,
  OrbitControls,
  useGLTF,
  useProgress
} from "@react-three/drei";
import { Suspense, useEffect, useMemo } from "react";
import * as THREE from "three";

const MODEL_URL = "/models/toyota_tundra_lowpoly.glb";

function LoadingModel() {
  const { progress } = useProgress();

  return (
    <Html center>
      <div
        style={{
          color: "#78c5ff",
          fontFamily: "monospace",
          fontSize: "12px",
          letterSpacing: "0.12em",
          whiteSpace: "nowrap"
        }}
      >
        LOADING TUNDRA {Math.round(progress)}%
      </div>
    </Html>
  );
}

function TundraModel() {
  const { scene } = useGLTF(MODEL_URL);

  const prepared = useMemo(() => {
    let sourceMesh: THREE.Mesh | null = null;

    scene.traverse((object) => {
      if (!sourceMesh && object instanceof THREE.Mesh) {
        sourceMesh = object;
      }
    });

    if (!sourceMesh) {
      throw new Error("The optimized Tundra GLB does not contain a mesh.");
    }

    const geometry = sourceMesh.geometry as THREE.BufferGeometry;
    const edgeGeometry = new THREE.EdgesGeometry(geometry, 18);

    const bodyMaterial = new THREE.MeshStandardMaterial({
      color: new THREE.Color("#071b2c"),
      roughness: 0.82,
      metalness: 0.08,
      transparent: true,
      opacity: 0.9,
      side: THREE.DoubleSide,
      depthWrite: true
    });

    const edgeMaterial = new THREE.LineBasicMaterial({
      color: new THREE.Color("#55b8f4"),
      transparent: true,
      opacity: 0.82,
      depthTest: true,
      depthWrite: false
    });

    return {
      geometry,
      edgeGeometry,
      bodyMaterial,
      edgeMaterial
    };
  }, [scene]);

  useEffect(() => {
    return () => {
      prepared.edgeGeometry.dispose();
      prepared.bodyMaterial.dispose();
      prepared.edgeMaterial.dispose();
    };
  }, [prepared]);

  return (
    <group position={[0, -1.02, 0]} rotation={[0, -0.62, 0]} scale={0.94}>
      <mesh
        geometry={prepared.geometry}
        material={prepared.bodyMaterial}
        frustumCulled
      >
        <lineSegments
          geometry={prepared.edgeGeometry}
          material={prepared.edgeMaterial}
          renderOrder={2}
        />
      </mesh>
    </group>
  );
}

function StaticRing({
  radius,
  opacity
}: {
  radius: number;
  opacity: number;
}) {
  const points = useMemo(() => {
    const curve = new THREE.EllipseCurve(
      0,
      0,
      radius,
      radius * 0.39,
      0,
      Math.PI * 2
    );

    return curve
      .getPoints(96)
      .map((point) => new THREE.Vector3(point.x, 0, point.y));
  }, [radius]);

  return (
    <group position={[0, -0.5, 0]}>
      <Line
        points={points}
        color="#278fef"
        lineWidth={0.65}
        transparent
        opacity={opacity}
      />
    </group>
  );
}

function Scene() {
  return (
    <>
      <color attach="background" args={["#020710"]} />
      <fog attach="fog" args={["#020710", 10, 22]} />

      <ambientLight intensity={1.3} />
      <directionalLight position={[5, 7, 6]} intensity={1.8} />
      <directionalLight position={[-4, 2, -5]} intensity={0.55} />

      <group position={[0, -0.08, 0]}>
        <Suspense fallback={<LoadingModel />}>
          <TundraModel />
        </Suspense>
        <StaticRing radius={4.3} opacity={0.58} />
        <StaticRing radius={5.4} opacity={0.26} />
      </group>

      <gridHelper
        args={[
          22,
          36,
          new THREE.Color("#164c7d"),
          new THREE.Color("#091827")
        ]}
        position={[0, -1.05, 0]}
      />

      <OrbitControls
        makeDefault
        enablePan={false}
        enableZoom={false}
        enableDamping={false}
        minPolarAngle={Math.PI / 3.3}
        maxPolarAngle={Math.PI / 2.05}
        minAzimuthAngle={-0.95}
        maxAzimuthAngle={0.95}
        target={[0, 0.2, 0]}
      />
    </>
  );
}

export default function VehicleScene() {
  return (
    <Canvas
      frameloop="demand"
      camera={{ position: [6.8, 4.15, 8.2], fov: 38 }}
      dpr={[0.55, 1]}
      gl={{
        antialias: true,
        alpha: false,
        powerPreference: "high-performance"
      }}
    >
      <AdaptiveDpr pixelated />
      <Scene />
    </Canvas>
  );
}

useGLTF.preload(MODEL_URL);
